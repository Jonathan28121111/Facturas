@inherits LayoutComponentBase
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #f3f4f6;
    }

    .main-layout {
        display: flex;
        min-height: 100vh;
    }

    .sidebar {
        width: 200px;
        background: #374151;
        box-shadow: 2px 0 5px rgba(0,0,0,0.1);
    }

    .sidebar-header {
        padding: 20px 15px;
        background: #4b5563;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

        .sidebar-header h3 {
            color: #f9fafb;
            font-size: 1.2rem;
            font-weight: 600;
            margin: 0;
        }

        .sidebar-header .subtitle {
            color: rgba(255,255,255,0.6);
            font-size: 0.75rem;
            margin-top: 3px;
        }

    .nav-menu {
        list-style: none;
        padding: 15px 0;
        margin: 0;
    }

    .nav-link {
        display: block;
        padding: 12px 20px;
        color: rgba(255,255,255,0.75);
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.9rem;
        border-left: 3px solid transparent;
    }

        .nav-link:hover {
            background: rgba(255,255,255,0.08);
            color: #f9fafb;
            border-left-color: #9ca3af;
        }

        .nav-link.active {
            background: rgba(255,255,255,0.1);
            color: #f9fafb;
            font-weight: 500;
            border-left-color: #d1d5db;
        }

    .content {
        flex: 1;
        background: #f3f4f6;
    }

    .nav-footer {
        padding: 15px;
        border-top: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.4);
        font-size: 0.7rem;
        text-align: center;
    }
</style>
<div class="main-layout">
    <div class="sidebar">
        <div class="sidebar-header">
            <h3>Sistema SAT</h3>
            <div class="subtitle">Gestion de Facturas</div>
        </div>
        <ul class="nav-menu">
            <li class="nav-item">
                <NavLink class="nav-link" href="documentos">
                    Facturas
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="reportes-sat">
                    Reportes Anuales
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="dashboard">
                    Dashboard
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="archivadas">
                    Documentos Archivados
                </NavLink>
            </li>
        </ul>
        <div class="nav-footer">
            v1.0 - 2025
        </div>
    </div>
    <div class="content">
        @Body
    </div>
</div>
